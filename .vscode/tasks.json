{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Sync KillBill from GitHub",
      "type": "shell",
      "command": "/bin/zsh",
      "args": [
        "${workspaceFolder}/scripts/sync_from_main.sh"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "runOptions": {
        "runOn": "folderOpen",
        "instanceLimit": 1
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true
      }
    }
  ]
}
